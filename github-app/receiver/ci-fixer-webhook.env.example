# ci-fixer-webhook.env — copy to /opt/ci-fixer-webhook/ci-fixer-webhook.env
# and fill in. Used by the systemd unit (non-container option).
WEBHOOK_SECRET=CHANGE_ME_strong_random
GITHUB_TOKEN=CHANGE_ME_fine_grained_with_write_on_central
CENTRAL_OWNER=CHANGE_ME
CENTRAL_REPO=copilot-central
DISPATCH_EVENT_TYPE=ci-fixer
# DISPATCH_BASE_URL=https://api.github.com
